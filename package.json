{
  "name": "opencode-squad",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "description": "SQUAD — multi-agent orchestrator plugin for OpenCode 2.3.0",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "verify": "bun run typecheck && bun run lint && bun test",
    "test": "bun test",
    "probe": "bun run scripts/probe-client.ts",
    "probe:keep": "bun run scripts/probe-client.ts --keep",
    "probe:interrupt": "bun run scripts/probe-interrupt.ts",
    "smoke:store": "bun run scripts/smoke-store.ts",
    "inspect": "bun run scripts/inspect.ts",
    "tui:live": "node scripts/tui-live.cjs",
    "vision:probe": "bun run scripts/vision-probe.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.4.1",
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependencies": {
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "effect": "^4.0.0",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@opencode/client": "2.4.1",
    "@opencode/schema": "2.4.1",
    "@opencode/theme": "2.4.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.20.0",
    "effect": "4.1.0",
    "node-pty": "^1.1.0",
    "typescript": "^5.9.3"
  }
}
